# BetaSeries API credentials (https://www.betaseries.com/api/)
# Both are exposed to the browser because of the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_BETASERIES_KEY=
NEXT_PUBLIC_BETASERIES_CLIENT_SECRET=

# Public URL of this app, used as the OAuth redirect_uri (e.g. http://localhost:3000)
NEXT_PUBLIC_URL=
